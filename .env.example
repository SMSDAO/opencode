# ── Storage (required for enterprise share/API server) ──────────────────────
# Adapter: "s3" (AWS) or "r2" (Cloudflare)
OPENCODE_STORAGE_ADAPTER=r2
OPENCODE_STORAGE_BUCKET=opencode-share
# For S3 only:
# OPENCODE_STORAGE_REGION=us-east-1
# For R2 only:
OPENCODE_STORAGE_ACCOUNT_ID=your-cloudflare-account-id
OPENCODE_STORAGE_ACCESS_KEY_ID=your-access-key-id
OPENCODE_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key

# ── Authentication ────────────────────────────────────────────────────────────
# Use a long random string (min 32 chars) for each secret
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=another-long-random-string-for-refresh-tokens
# Session expiry in hours (default: 8)
# SESSION_TIMEOUT_HOURS=8

# ── Database (optional — PostgreSQL) ─────────────────────────────────────────
# DATABASE_URL=postgresql://opencode:password@localhost:5432/opencode
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ── Billing / Stripe (optional) ───────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Deployment target ─────────────────────────────────────────────────────────
# Set to "cloudflare" to build the enterprise app for Cloudflare Workers
# OPENCODE_DEPLOYMENT_TARGET=cloudflare
